process {

    // Small enough that both batches run concurrently, so the small one can finish first.
    withName: 'TRANSDECODER_LONGORF|TRANSDECODER_PREDICT' {
        cpus   = 1
        memory = 1.GB
    }

    // Start-codon refinement crashes with one ORF candidate per batch.
    withName: 'TRANSDECODER_PREDICT' {
        ext.args = '--no_refine_starts'
    }

}
