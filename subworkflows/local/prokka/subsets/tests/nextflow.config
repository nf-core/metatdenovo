params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
}

process {

    // One batch per contig means two PROKKA tasks; keep both small enough that a CI runner
    // executes them without queueing.
    withName: 'PROKKA' {
        cpus   = 1
        memory = 2.GB
    }

}
