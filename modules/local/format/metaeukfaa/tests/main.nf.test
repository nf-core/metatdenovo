nextflow_process {

    name "Test Process FORMAT_METAEUKFAA"
    script "../main.nf"
    process "FORMAT_METAEUKFAA"

    tag "modules"
    tag "modules_local"
    tag "format"
    tag "format/metaeukfaa"

    // Real headers from the metaeuk test profile.

    test("metaeuk fasta - headers rewritten to the gff id form") {

        when {
            process {
                """
                def faa = file("\${workDir}/metaeuk.fas")
                faa.text = [
                    '>NP_011412.1|k59_0|+|310|1.429e-91|1|0|446|0[0]:446[446]:447[447]',
                    'MPSRFTKTRKHRGHVSAGKGRIGKHRKHPGGRGMAGGQHHHRINMDKYHPGYFGKVGMRY',
                    'FHKQQAHFWKPVLNLDKLWTLIPEDKRDQYLKSASKETAPVIDTLAAGYGKILGKGRIPN',
                    '>NP_011412.1|k59_1|-|318|5.581e-94|2|191|1148|1148[1148]:1101[1101]:48[48]|592[589]:191[191]:402[399]',
                    'MPSRFTKTRKHRGHVSAGKGRIGKHRKHPGGRGMAGGQHHHRINMDKYHPGYFGKVGMRY',
                    ''
                ].join('\\n')

                input[0] = [ [ id:'test' ], faa ]
                """
            }
        }

        then {
            def ids = path(process.out.format_faa[0][1]).linesGzip.findAll { l -> l.startsWith('>') }
            assertAll(
                { assert process.success },
                // Fields 1,2,3,7, not the first four: field 4 is the bitscore.
                { assert ids == ['>NP_011412.1|k59_0|+|0', '>NP_011412.1|k59_1|-|191'] },
                { assert path(process.out.format_faa[0][1]).linesGzip.findAll { l -> !l.startsWith('>') }.size() == 3 },
                { assert snapshot(process.out.format_faa).match() }
            )
        }
    }

    test("header with too few fields - fails loudly") {

        when {
            process {
                """
                def faa = file("\${workDir}/short.fas")
                faa.text = '>NP_011412.1|k59_0|+|310\\nMPSRFTK\\n'

                input[0] = [ [ id:'test' ], faa ]
                """
            }
        }

        then {
            // Passing a short header through would break the gff id match, so it must error.
            assert process.failed
        }
    }

    test("metaeuk fasta - stub") {

        options "-stub"

        when {
            process {
                """
                def faa = file("\${workDir}/metaeuk.fas")
                faa.text = '>NP_011412.1|k59_0|+|310|1.429e-91|1|0|446|x\\nMPSRFTK\\n'

                input[0] = [ [ id:'test' ], faa ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
