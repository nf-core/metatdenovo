nextflow_process {

    name "Test Process FORMAT_GFF2BED"
    script "../main.nf"
    process "FORMAT_GFF2BED"

    tag "modules"
    tag "modules_local"
    tag "format"
    tag "format/gff2bed"


    test("cds with ID= attribute - bed line produced") {

        when {
            process {
                """
                def gff = file("\${workDir}/test.gff")
                gff.text = [
                    'k1\\tprokka\\tCDS\\t1\\t100\\t.\\t+\\t0\\tID=gene1;Target_ID=x;TCS_ID=y',
                    ''
                ].join('\\n')

                input[0] = [ [ id:'test', caller:'prokka' ], gff ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Must match the real ID=, not the substring inside Target_ID=/TCS_ID=.
                { assert path(process.out.bed[0][1]).csv(sep: "\t", header: false).rows[0] ==
                    ["C0": "k1", "C1": 0, "C2": 100, "C3": "prokka:gene1", "C4": 0, "C5": "+"] }
            )
        }
    }

    test("cds with no ID= attribute - fails loudly") {

        when {
            process {
                """
                def gff = file("\${workDir}/test.gff")
                gff.text = [
                    'k1\\tMetaEuk\\tCDS\\t1\\t100\\t.\\t+\\t0\\tTarget_ID=x;TCS_ID=x|k1|+|0',
                    ''
                ].join('\\n')

                input[0] = [ [ id:'test', caller:'metaeuk' ], gff ]
                """
            }
        }

        then {
            // An empty id would merge unrelated loci downstream, so it must error.
            assert process.failed
            assert process.errorReport.contains("ERROR: CDS record has no ID= attribute")
        }
    }

    test("gff2bed - stub") {

        options "-stub"

        when {
            process {
                """
                def gff = file("\${workDir}/test.gff")
                gff.text = 'k1\\tprokka\\tCDS\\t1\\t100\\t.\\t+\\t0\\tID=gene1\\n'

                input[0] = [ [ id:'test', caller:'prokka' ], gff ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
