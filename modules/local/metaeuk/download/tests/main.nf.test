nextflow_process {

    name "Test Process METAEUK_DOWNLOAD"
    script "../main.nf"
    process "METAEUK_DOWNLOAD"

    tag "modules"
    tag "modules_local"
    tag "metaeuk"
    tag "metaeuk/download"

    // A real (non-stub) run downloads and builds a full MetaEuk reference database
    // (the smallest of which is still far too large for CI), so only the stub is tested here.
    test("UniRef50 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = 'UniRef50'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    // A db_name with a `/` (e.g. UniProtKB/Swiss-Prot, from `metaeuk databases -h`) can't be
    // used directly as a directory/prefix name -- this is the case that exercises db_dir.
    test("UniProtKB/Swiss-Prot - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = 'UniProtKB/Swiss-Prot'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
