%%     --logo nf-core-metatdenovo_logo_light.png -o nf-core-metatdenovo_metro_map_light.svg
%%   nf-metro render nf-core-metatdenovo_metro_map.mmd --theme nfcore --mode dark --embed-font \
%%     --logo nf-core-metatdenovo_logo_dark.png -o nf-core-metatdenovo_metro_map_dark.svg
