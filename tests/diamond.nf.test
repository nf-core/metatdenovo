nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    profile "test_diamond"

    test("-profile test_diamond") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots', 'multiqc/multiqc_plots/**' ])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            def batches = { db -> new File("${params.outdir}/diamond_taxonomy").listFiles().findAll { f -> f.name ==~ /megahit\.prodigal\.\d{3}\.${db}\.tsv\.gz/ }.sort { f -> f.name } }
            def lineage = { db -> path("${params.outdir}/diamond_taxonomy/megahit.prodigal.${db}.lineage.tsv.gz").linesGzip.collect { l -> l.split('\t')[0] } }
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_metatdenovo_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path,
                ).match() },
                // Fixture dbs: https://github.com/nf-core/test-datasets/blob/metatdenovo/test_data/diamond_taxonomy/README.md
                // --diamond_batchsize splits the proteins into several batches; their lineage file holds each hit once
                { assert batches('ncbi-refseq-test').size() > 1 },
                { assert batches('gtdb-r220-test').size() > 1 },
                { assert lineage('ncbi-refseq-test').size() > 0 },
                { assert lineage('gtdb-r220-test').size() > 0 },
                { assert lineage('ncbi-refseq-test') == batches('ncbi-refseq-test').collectMany { f -> path(f.toString()).linesGzip }.collect { l -> l.split('\t')[0] } },
                { assert lineage('gtdb-r220-test') == batches('gtdb-r220-test').collectMany { f -> path(f.toString()).linesGzip }.collect { l -> l.split('\t')[0] } },
                // parse_with_taxdump (ncbi-refseq-test) gives NCBI taxon names
                { assert path("${params.outdir}/summary_tables/megahit.prodigal.ncbi-refseq-test.diamond.taxonomy-taxdump.tsv.gz").linesGzip.findAll { l -> l.contains('Escherichia coli') || l.contains('cerevisiae') }.size() > 0 },
                // ranks (gtdb-r220-test) gives ranked lineage columns
                { assert path("${params.outdir}/summary_tables/megahit.prodigal.gtdb-r220-test.diamond.taxonomy.tsv.gz").linesGzip.findAll { l -> l.contains('Acinetobacter') || l.contains('Bacteroides') }.size() > 0 },
            )
        }
    }
}
