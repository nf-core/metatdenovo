nextflow_pipeline {

    name "Test pipeline with digital normalization"
    script "../main.nf"
    tag "pipeline"
    profile "test_bbnorm"

    test("-profile test_bbnorm") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots', 'multiqc/multiqc_plots/**' ])
            assert workflow.success
            assertAll(
                // Published paths and the versions file only, deliberately not file contents.
                // BBNorm sizes its k-mer hash tables from the memory it is given, so which
                // low-abundance k-mers survive normalisation -- and therefore the assembly and
                // every table derived from it -- can differ between machines that allocate it
                // different amounts. Asserting content here would snapshot this runner's memory.
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_metatdenovo_software_mqc_versions.yml"),
                    stable_path,
                ).match() },

                // BBNorm normalises the reads that go into the assembler, and only those -- the
                // full, un-normalised set is what gets mapped back for quantification. So the
                // per-sample read counts in overall_stats must still be the untouched input
                // counts: if normalised reads ever leaked into quantification, every count here
                // would drop, silently and proportionally.
                { assert path("${params.outdir}/summary_tables/megahit.prodigal.overall_stats.tsv.gz")
                    .csv(sep: '\t', decompress: true, header: true)
                    .columns["n_post_trimming"].every { n -> n.toInteger() > 0 } },

                // The log BBNorm's own MultiQC section is built from, and the evidence that the
                // step actually ran rather than being skipped.
                { assert path("${params.outdir}/bbmap/bbnorm/all_samples.bbnorm.log").readLines()
                    .any { l -> l.contains('Total reads in:') } },

                { assert path("${params.outdir}/megahit/megahit_assembly.log").readLines().any { l -> l.contains('ALL DONE') } }
            )
        }
    }
}
