nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    profile "test_megahit_prokka_transdecoder"

    test("-profile test_megahit_prokka_transdecoder") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots', 'multiqc/multiqc_plots/**' ])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_metatdenovo_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path,
                    // Should match the solo-caller snapshots, showing the callers do not contaminate each other.
                    path("${params.outdir}/summary_tables/megahit.prokka.counts.tsv.gz").linesGzip.findAll { l -> l.contains('orf') },
                    path("${params.outdir}/summary_tables/megahit.prokka.counts.tsv.gz").csv(sep: '\t', decompress: true, header: true).columns["tpm"].sum().round(),
                    path("${params.outdir}/summary_tables/megahit.prokka.overall_stats.tsv.gz").linesGzip.findAll { l -> l.contains('prokka') },
                    path("${params.outdir}/summary_tables/megahit.transdecoder.counts.tsv.gz").linesGzip.findAll { l -> l.contains('orf') },
                    path("${params.outdir}/summary_tables/megahit.transdecoder.counts.tsv.gz").csv(sep: '\t', decompress: true, header: true).columns["tpm"].sum().round(),
                    path("${params.outdir}/summary_tables/megahit.transdecoder.overall_stats.tsv.gz").linesGzip.findAll { l -> l.contains('transdecoder') },
                ).match() },
                { assert path("${params.outdir}/megahit/megahit_assembly.log").readLines().any { l -> l.contains('ALL DONE') } },
                { assert path("${params.outdir}/megahit/megahit_assembly.contigs.fa.gz").linesGzip.size() > 3000 },
                { assert path("${params.outdir}/prokka/prokka.gff.gz").linesGzip.size() > 2000 },
                { assert path("${params.outdir}/summary_tables/megahit.prokka.counts.tsv.gz").linesGzip.size() > 2000 },
                { assert path("${params.outdir}/summary_tables/megahit.transdecoder.counts.tsv.gz").linesGzip.size() > 1000 },

                // One featureCounts file per sample and caller.
                { assert path("${params.outdir}/featurecounts/SAMPLE1_PE.prokka.featureCounts.tsv").exists() },
                { assert path("${params.outdir}/featurecounts/SAMPLE1_PE.transdecoder.featureCounts.tsv").exists() },
                { assert path("${params.outdir}/featurecounts/SAMPLE2_PE.prokka.featureCounts.tsv").exists() },
                { assert path("${params.outdir}/featurecounts/SAMPLE2_PE.transdecoder.featureCounts.tsv").exists() },
                // SAMPLE3_PE has two samplesheet rows, so CAT_FASTQ adds a "_1" suffix.
                { assert path("${params.outdir}/featurecounts/SAMPLE3_PE_1.prokka.featureCounts.tsv").exists() },
                { assert path("${params.outdir}/featurecounts/SAMPLE3_PE_1.transdecoder.featureCounts.tsv").exists() },

                // The callers' ORF ids must not overlap.
                { assert (
                    path("${params.outdir}/summary_tables/megahit.prokka.counts.tsv.gz").csv(sep: '\t', decompress: true, header: true).columns["orf"].toSet()
                    .intersect(
                        path("${params.outdir}/summary_tables/megahit.transdecoder.counts.tsv.gz").csv(sep: '\t', decompress: true, header: true).columns["orf"].toSet()
                    )
                ).isEmpty() },

                // Diamond taxonomy for every caller and db: the diamond-taxonomy joins are keyed by db name,
                // so two callers sharing one db is the duplicate-key case where .join() silently drops results.
                { assert path("${params.outdir}/summary_tables/megahit.prokka.gtdb-r220-test.diamond.taxonomy.tsv.gz").exists() },
                { assert path("${params.outdir}/summary_tables/megahit.prokka.ncbi-refseq-test.diamond.taxonomy.tsv.gz").exists() },
                { assert path("${params.outdir}/summary_tables/megahit.prokka.ncbi-refseq-test.diamond.taxonomy-taxdump.tsv.gz").exists() },
                { assert path("${params.outdir}/summary_tables/megahit.transdecoder.gtdb-r220-test.diamond.taxonomy.tsv.gz").exists() },
                { assert path("${params.outdir}/summary_tables/megahit.transdecoder.ncbi-refseq-test.diamond.taxonomy.tsv.gz").exists() },
                { assert path("${params.outdir}/summary_tables/megahit.transdecoder.ncbi-refseq-test.diamond.taxonomy-taxdump.tsv.gz").exists() },
            )
        }
    }
}
