nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    profile "test_annotate_only_consolidated"

    test("-profile test_annotate_only_consolidated") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots', 'multiqc/multiqc_plots/**' ])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_metatdenovo_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path,
                ).match() },

                // === --annotate_only_consolidated (on by default): with two ORF callers plus
                // protein consolidation, HMMCLASSIFY should only have run on the cluster
                // representatives, not on either caller's own full protein set as well. ===
                { assert path("${params.outdir}/summary_tables/megahit.protein_consolidate_99.hmmrank.tsv.gz").exists() },
                { assert ! path("${params.outdir}/summary_tables/megahit.prokka.hmmrank.tsv.gz").exists() },
                { assert ! path("${params.outdir}/summary_tables/megahit.prodigal.hmmrank.tsv.gz").exists() },

                // Each caller's own (non-annotation) counts tables are untouched by the restriction --
                // it only narrows what gets annotated, not what gets called/counted.
                { assert path("${params.outdir}/summary_tables/megahit.prokka.counts.tsv.gz").exists() },
                { assert path("${params.outdir}/summary_tables/megahit.prodigal.counts.tsv.gz").exists() },
            )
        }
    }

    test("-profile test_annotate_only_consolidated --annotate_only_consolidated false") {

        when {
            params {
                outdir                     = "$outputDir"
                annotate_only_consolidated = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },

                // === With the restriction switched off, every source is annotated: both callers'
                // own hmmrank tables AND the consolidated representatives' -- proving the default-on
                // test above is actually exercising this param, not some other unconditional path. ===
                { assert path("${params.outdir}/summary_tables/megahit.protein_consolidate_99.hmmrank.tsv.gz").exists() },
                { assert path("${params.outdir}/summary_tables/megahit.prokka.hmmrank.tsv.gz").exists() },
                { assert path("${params.outdir}/summary_tables/megahit.prodigal.hmmrank.tsv.gz").exists() },
            )
        }
    }
}
