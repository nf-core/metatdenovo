nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    profile "test_metaeuk_transdecoder"

    test("-profile test_metaeuk_transdecoder") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots', 'multiqc/multiqc_plots/**' ])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // MEGAHIT numbers the two contigs in either order between runs, so name them by length.
            def contig_names = path("${params.outdir}/megahit/megahit_assembly.contigs.fa.gz").linesGzip
                .findAll { l -> l.startsWith('>') }
                .collect { l -> [ l.substring(1).tokenize(' ')[0], (l =~ /len=(\d+)/)[0][1] as Integer ] }
                .sort { c -> c[1] }
                .with { cs -> [ (cs[0][0]): 'mrna_contig', (cs[1][0]): 'genomic_contig' ] }
            def renamed = { String s -> s.replaceAll(/k\d+_\d+/) { id -> contig_names[id] ?: id } }
            def table = { String name ->
                path("${params.outdir}/summary_tables/${name}").csv(sep: '\t', decompress: true, header: true).rows
                    .collect { r -> r.collectEntries { k, v -> [ (k): v instanceof String ? renamed(v) : v ] } }
            }
            assertAll(
                { assert contig_names.size() == 2 },
                { assert workflow.success },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_metatdenovo_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path,
                    // Should match tests/metaeuk.nf.test's snapshot, showing the callers do not contaminate each other.
                    path("${params.outdir}/summary_tables/megahit.metaeuk.counts.tsv.gz").linesGzip.findAll { l -> l.contains('orf') },
                    path("${params.outdir}/summary_tables/megahit.transdecoder.counts.tsv.gz").linesGzip.findAll { l -> l.contains('orf') },
                    // Small enough to snapshot verbatim.
                    path("${params.outdir}/summary_tables/megahit.locus_consolidate.counts.tsv.gz").linesGzip.collect(renamed),
                    // Likewise the protein-consolidated table.
                    path("${params.outdir}/summary_tables/megahit.protein_consolidate_99.counts.tsv.gz").linesGzip.collect(renamed),
                ).match() },
                { assert path("${params.outdir}/megahit/megahit_assembly.log").readLines().any { l -> l.contains('ALL DONE') } },
                { assert path("${params.outdir}/megahit/megahit_assembly.contigs.fa.gz").linesGzip.size() >= 4 },

                // Both callers call mrna_contig at 1-447 (+) with 400 reads each; the consolidated count must be 400, not 800.
                { assert (
                    table('megahit.locus_consolidate.counts.tsv.gz')
                        .findAll { r -> r["sample"] == 'RPL28_MRNA_RECODED' }
                        .sum { r -> r["count"] as int }
                ) == 400 },
                // Both callers contributed, two calls.
                { assert (
                    table('megahit.locus_consolidate.counts.tsv.gz')
                        .find { r -> r["sample"] == 'RPL28_MRNA_RECODED' }
                        .with { r -> [ r["callers"].tokenize(',').toSet(), r["n_calls"] as int ] }
                ) == [ ['metaeuk', 'transdecoder'] as Set, 2 ] },

                // genomic_contig: MetaEuk (-) and TransDecoder (+) overlap on opposite strands, so must stay two loci.
                { assert (
                    table('megahit.locus_consolidate.counts.tsv.gz')
                        .findAll { r -> r["orf"] == 'genomic_contig.p1' || r["orf"].startsWith('NP_011412.1|genomic_contig') }
                        .every { r -> (r["n_calls"] as int) == 1 }
                ) },

                // No sample's locus counts may exceed its aligned reads (samtools flagstat).
                { assert (
                    ['RPL28_GENOMIC', 'RPL28_MRNA', 'RPL28_MRNA_RECODED'].every { sample ->
                        def consolidated_total = table('megahit.locus_consolidate.counts.tsv.gz')
                            .findAll { r -> r["sample"] == sample }
                            .sum { r -> r["count"] as int } ?: 0
                        def flagstat_total = path("${params.outdir}/samtools/megahit.${sample}.flagstat").readLines()[0].tokenize(' ')[0] as int
                        consolidated_total <= flagstat_total
                    }
                ) },

                // genomic_contig (spliced, -) and mrna_contig (recoded mRNA, +) are the same gene on different contigs.
                // Locus consolidation cannot merge them; protein clustering must, with provenance from both.
                { assert (
                    table('megahit.protein_consolidate_99.counts.tsv.gz')
                        .findAll { r -> (r["n_loci"] as int) == 2 }
                        .every { r ->
                            r["loci"].tokenize(',').toSet() == [ 'NP_011412.1|genomic_contig|-|191', 'locus_mrna_contig_1_447_+' ] as Set &&
                            r["callers"].tokenize(',').toSet() == [ 'metaeuk', 'transdecoder' ] as Set &&
                            (r["n_calls"] as int) == 3
                        }
                ) },
                // The opposite-strand TransDecoder call on genomic_contig is a different protein and must stay out.
                { assert (
                    table('megahit.protein_consolidate_99.counts.tsv.gz')
                        .findAll { r -> r["orf"] == 'genomic_contig.p1' }
                        .every { r -> (r["n_loci"] as int) == 1 && r["callers"] == 'transdecoder' }
                ) },
                // Clustering regroups rows: per-sample totals equal the locus level.
                { assert (
                    ['RPL28_GENOMIC', 'RPL28_MRNA', 'RPL28_MRNA_RECODED'].every { sample ->
                        def total = { name ->
                            table(name)
                                .findAll { r -> r["sample"] == sample }
                                .sum { r -> r["count"] as int } ?: 0
                        }
                        total('megahit.protein_consolidate_99.counts.tsv.gz') == total('megahit.locus_consolidate.counts.tsv.gz')
                    }
                ) },
                // Representatives must be keyed like the counts table's 'orf' column, or annotation joins are empty.
                // The cluster table is in .nftignore (MEGAHIT is not deterministic), so assert its shape.
                { assert (
                    path("${params.outdir}/protein_consolidate/megahit.protein_consolidate_99.clusters.tsv").readLines()
                        .every { l -> l.tokenize('\t').size() == 2 }
                ) },
                { assert (
                    path("${params.outdir}/protein_consolidate/megahit.protein_consolidate_99.clusters.tsv").readLines()
                        .collect { l -> l.tokenize('\t') }
                        .with { rows -> rows.collect { r -> r[0] }.toSet().every { rep -> rows.any { r -> r[0] == rep && r[1] == rep } } }
                ) },
                { assert (
                    path("${params.outdir}/summary_tables/megahit.protein_consolidate_99.counts.tsv.gz")
                        .csv(sep: '\t', decompress: true, header: true).columns["orf"].toSet()
                ).every { orf -> orf in (
                    path("${params.outdir}/protein_consolidate/megahit.protein_consolidate_99.representatives.fa.gz").linesGzip
                        .findAll { l -> l.startsWith('>') }
                        .collect { l -> l.substring(1).tokenize(' ')[0] }
                        .toSet()
                ) } },
            )
        }
    }
}
