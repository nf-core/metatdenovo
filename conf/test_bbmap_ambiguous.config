/*
========================================================================================
    Nextflow config file for running minimal tests
========================================================================================
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/metatdenovo -profile test_bbmap_ambiguous,<docker/singularity>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile for BBMap multi-mapping + fractional featureCounts'
    config_profile_description = 'Minimal test dataset to check --bbmap_ambiguous all + --featurecounts_fraction'

    // Input data
    input      = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/samplesheet.csv'

    // Params
    assembler  = 'megahit'
    orf_caller = 'prodigal'

    // ambig=all needs --featurecounts_fraction, or multi-mapped reads are counted in full at every site.
    bbmap_ambiguous        = 'all'
    featurecounts_fraction = true

    skip_eukulele              = true
    skip_kofamscan             = true
    skip_eggnog                = true
    skip_dbcan                 = true
    skip_protein_consolidation = true
}
