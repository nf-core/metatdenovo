/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/metatdenovo -profile test_diamond,<docker/singularity>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test Diamond taxonomy profile'
    config_profile_description = 'Minimal test dataset to check pipeline function with the --diamond_dbs option'

    // Input data
    input       = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/samplesheet.csv'
    diamond_dbs = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/diamond_dbs.csv'

    assembler      = 'megahit'
    orf_caller     = 'prodigal'

    // Other options
    skip_eukulele  = true
    skip_eggnog    = true
    skip_kofamscan = true
}
