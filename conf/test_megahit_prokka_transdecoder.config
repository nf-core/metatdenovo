/*
========================================================================================
    Nextflow config file for running minimal tests
========================================================================================
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/metatdenovo -profile test_megahit_prokka_transdecoder,<docker/singularity>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile for multiple ORF callers (prokka + transdecoder)'
    config_profile_description = 'Minimal test dataset to check pipeline function with multiple --orf_caller values'

    // Input data
    input    = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/samplesheet.csv'

    // Params
    assembler  = 'megahit'
    orf_caller = 'prokka,transdecoder'

    // diamond_dbs is on here (unlike the plain solo prokka/transdecoder profiles): the real bug this
    // combination actually caught during development is Nextflow's .join() silently dropping
    // duplicate left-side keys, which needs multiple callers sharing the same diamond db-name key --
    // something a single-caller test can never produce, even with multiple diamond dbs (like
    // tests/diamond.nf.test). No hmmfiles/kofamscan here: KOFAMSCAN_SUM/EGGNOG_SUM/DBCAN_SUM's
    // join-by-caller fix is keyed uniquely per caller regardless of caller count, so a single-caller
    // test already proves that mechanism -- adding it here would just cost CI disk for no extra
    // coverage (an earlier, heavier version of this profile that combined 3 callers with the full
    // hmmfiles/kofamscan/diamond_dbs set exhausted the CI runner's disk).
    diamond_dbs = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/diamond_dbs.csv'

    skip_eukulele  = true
    skip_kofamscan = true
    skip_eggnog    = true
    skip_dbcan     = true
}
