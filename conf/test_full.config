/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/metatdenovo -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // Input data for full size test
    input = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/samplesheet_full_test.csv'
    hmmfiles = 'https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF00317.hmm,https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF00848.hmm,https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF03477.hmm,https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF13597.hmm'
    sequence_filter = 'https://github.com/nf-core/test-datasets/raw/metatdenovo/test_data/rrna.fna.gz'

    // parameters
    assembler       = 'megahit'
    // prokka alone would leave protein consolidation with nothing to merge, since it only ever
    // merges calls from different callers. The full-size data is a metatranscriptome and so is
    // mostly prokaryotic, but eukaryotes are expected in it and TransDecoder finds ORFs Prokka
    // does not -- so this is the one profile where cross-caller consolidation is exercised at
    // realistic scale, which is also the scale its memory behaviour needs testing at.
    orf_caller      = 'prokka,transdecoder'
    skip_eukulele   = false
    skip_eggnog     = false
    skip_kofamscan  = true
    // dbCAN downloads its own database and caches it in the storeDir dbcan_dbpath points at. That
    // is an s3:// path here, and writing to it needs an AWS CLI the environment does not have, so
    // the download succeeds and the run then dies copying it into the store. Skipped until #471 is
    // fixed, after which this is just a flag flip -- nothing needs uploading. KOfamScan (skipped
    // above) works the same way and can be enabled at the same time.
    skip_dbcan      = true
    eukulele_db     = 'phylodb'
    eukulele_dbpath = 's3://ngi-igenomes/test-data/metatdenovo/gtdb_eukulele/'
    eggnog_dbpath   = 's3://ngi-igenomes/test-data/metatdenovo/eggnog/'
    dbcan_dbpath    = 's3://ngi-igenomes/test-data/metatdenovo/dbcan/'
}
