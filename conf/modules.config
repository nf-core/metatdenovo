/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/
process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        enabled: false
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: TRIMGALORE {
        ext.args = { [
            '--fastqc',
            params.trim_nextseq > 0 ? "--nextseq ${params.trim_nextseq}" : ''
        ].join(' ').trim() }
        publishDir = [
            [
                path: { "${params.outdir}/trimgalore/fastqc" },
                mode: params.publish_dir_mode,
                pattern: "*.{html,zip}"
            ],
            [
                path: { "${params.outdir}/trimgalore" },
                mode: params.publish_dir_mode,
                pattern: "*.txt"
            ]
        ]
    }

    withName: SEQTK_MERGEPE {
        ext.prefix = { "${meta.id}.processed" }
    }

    withName: BBMAP_BBNORM {
        ext.args = { [
            "target=${params.bbnorm_target}",
            "min=${params.bbnorm_min}",
        ].join(' ').trim() }
        publishDir = [
            [
                path : { "${params.outdir}/bbmap/bbnorm" },
                mode: params.publish_dir_mode,
                pattern: "*.log"
            ],
            [
                path : { "${params.outdir}/bbmap/bbnorm/"},
                mode: params.publish_dir_mode,
                pattern: "*.fastq.gz",
                enabled: params.save_bbnorm_fastq
            ]
        ]
    }

    // BBMap's tool suite (bbduk here for contaminant removal, bbmap itself below for read
    // mapping) is used rather than e.g. Bowtie2, more commonly seen in other nf-core
    // pipelines. Bushnell's benchmark (BBMap: A Fast, Accurate, Splice-Aware Aligner,
    // LBNL-7065E, 2014, https://www.osti.gov/biblio/1241166) found that Bowtie2 "failed to
    // index the soil metagenome, so it cannot be recommended for metagenomics" -- an
    // assembly-scale, multi-contig reference is exactly this pipeline's index. See
    // BBMAP_ALIGN below for the other reason (ambiguous multi-mapping control) this choice
    // matters for counting.
    withName: BBMAP_BBDUK {
        ext.save_removed = params.save_bbduk_removed_fastq
        publishDir = [
            [
                path : { "${params.outdir}/bbmap/bbduk/"},
                pattern: '*.fastq.gz',
                mode: params.publish_dir_mode,
                enabled: params.save_bbduk_fastq
            ],
            [
                path : { "${params.outdir}/bbmap/bbduk/"},
                pattern: '*.matched.fq.gz',
                mode: params.publish_dir_mode,
                enabled: params.save_bbduk_removed_fastq
            ],
            [
                path : { "${params.outdir}/bbmap/bbduk/"},
                pattern: '*.bbduk.log',
                mode: params.publish_dir_mode
            ]
        ]
    }

    withName: MEGAHIT {
        ext.args = { [
            "-m ${task.memory.toBytes()}",
            params.megahit_k_min     ? "--k-min ${params.megahit_k_min}"        : '',
            params.megahit_k_max     ? "--k-max ${params.megahit_k_max}"        : '',
            params.megahit_k_step    ? "--k-step ${params.megahit_k_step}"      : '',
            params.megahit_k_list    ? "--k-list ${params.megahit_k_list}"      : '',
            params.megahit_min_count ? "--min-count ${params.megahit_min_count}" : '',
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/megahit" },
            mode: params.publish_dir_mode,
            pattern: '{*.contigs.fa.gz,*.log}'
        ]
    }

    withName: WRITESPADESYAML {
        publishDir = [
            path: { "${params.outdir}/spades" },
            mode: params.publish_dir_mode,
            pattern: '*.yaml'
        ]
    }

    withName: SPADES {
        ext.args = { "--${params.spades_flavor}" }
        publishDir = [
            path: { "${params.outdir}/spades" },
            mode: params.publish_dir_mode,
            pattern: '*.{gz,log}'
        ]
    }

    withName: FORMATSPADES {
        publishDir = [
            path: { "${params.outdir}/spades" },
            mode: params.publish_dir_mode,
            pattern: '*.fa.gz',
            enabled: params.save_formatspades
        ]
    }

    withName: SEQTK_SEQ_CONTIG_FILTER {
        ext.args = { "-L ${params.min_contig_length}" }
    }

    // See BBMAP_BBDUK above for why BBMap (not e.g. Bowtie2) is used here too. BBMap's
    // `ambig=` option gives explicit control over how reads multi-mapping across
    // related/conserved regions of the assembly get resolved -- Bowtie2 doesn't expose the
    // same semantics; see --bbmap_ambiguous handling in workflows/metatdenovo.nf.
    withName: BBMAP_ALIGN {
        ext.args = { "trimreaddescriptions=t pigz=t minid=${params.bbmap_minid} ambig=${params.bbmap_ambiguous}" }
        publishDir = [
            [
                path: { "${params.outdir}/bbmap/bbmap/" },
                mode: params.publish_dir_mode,
                pattern: "*.bam",
                enabled: params.save_bam
            ],
            [
                path: { "${params.outdir}/bbmap/bbmap" },
                mode: params.publish_dir_mode,
                pattern: "*.log"
            ]
        ]
    }

    withName: SAMTOOLS_SORT {
        ext.prefix = { "${meta.id}.sorted" }
    }

    withName: ".*SAMTOOLS.*" {
        publishDir = [
            [
                pattern: "*.bam",
                path: { "${params.outdir}/samtools/" },
                mode: params.publish_dir_mode

            ],
            [
                pattern: "*.bam.bai",
                path: { "${params.outdir}/samtools/" },
                mode: params.publish_dir_mode
            ],
            [
                pattern: "*.{flagstat,idxstats}",
                path: { "${params.outdir}/samtools/" },
                mode: params.publish_dir_mode,
                enabled: params.save_samtools,
                saveAs: { filename -> "${params.assembler ?: params.user_assembly_name}.${filename}" }
            ]
        ]
    }

    withName: PRODIGAL {
        ext.args = { params.prodigal_trainingfile ? "-t $params.prodigal_trainingfile" : "-p meta" }
        publishDir = [
            path: { "${params.outdir}/prodigal" },
            mode: params.publish_dir_mode,
            pattern: "*.gz"
        ]
    }

    withName: FORMAT_PRODIGAL_GFF {
        publishDir = [
            path: { "${params.outdir}/prodigal" },
            mode: params.publish_dir_mode,
            pattern: "*.gz"
        ]
    }

    // No publishDir here: METAEUK_EASYPREDICT now runs once per assembly batch (see
    // subworkflows/local/metaeuk/), so its raw per-batch outputs are just intermediates --
    // same as bare PROKKA below, which has no publishDir either. The meaningful,
    // already-concatenated final output is published by FORMAT_METAEUKFAA/FORMAT_METAEUK_GFF.
    withName: 'FORMAT_METAEUKFAA|FORMAT_METAEUK_GFF' {
        publishDir = [
            path: { "${params.outdir}/metaeuk" },
            mode: params.publish_dir_mode,
            pattern: "*.gz"
        ]
    }

    withName: 'TRANSDECODER_LONGORF|TRANSDECODER_PREDICT' {
        publishDir = [
            path: { "${params.outdir}/transdecoder" },
            mode: params.publish_dir_mode,
            pattern: "*transdecoder/*.transdecoder.{bed,cds,gff3,pep}",
            saveAs: { filename -> filename },
            enabled: false
        ]
    }

    withName: 'PIGZ_TRANSDECODER_.*' {
        publishDir = [
            path: { "${params.outdir}/transdecoder" },
            mode: params.publish_dir_mode,
            pattern: "*.transdecoder.{bed,cds,gff3,pep}.gz",
            saveAs: { filename -> filename }
        ]
    }

    withName: 'PROKKA' {
        ext.args = '--metagenome'
    }

    withName: 'FAA_CAT' {
        ext.prefix = 'prokka.faa.gz'
        publishDir = [
            path: { "${params.outdir}/prokka" },
            mode: params.publish_dir_mode,
            pattern: "*.gz"
        ]
    }

    withName: 'FFN_CAT' {
        ext.prefix = 'prokka.ffn.gz'
        publishDir = [
            path: { "${params.outdir}/prokka" },
            mode: params.publish_dir_mode,
            pattern: "*.gz"
        ]
    }

    withName: 'GFF_CAT' {
        ext.prefix = 'prokka.gff.gz'
        publishDir = [
            path: { "${params.outdir}/prokka" },
            mode: params.publish_dir_mode,
            pattern: "*.gz"
        ]
    }

    withName: PROKKAGFF2TSV {
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.prokka-annotations.tsv.gz"
        ]
    }

    withName: '.*:FEATURECOUNTS_CDS' {
        // -M: count multi-mapped reads (only has any effect on reads with a secondary alignment
        // in the BAM, i.e. in practice only when --bbmap_ambiguous all is used -- a no-op under
        // the default best/random/toss, since those never produce a secondary alignment).
        // --fraction (opt-in via --featurecounts_fraction): weight each multi-mapped read's
        // contribution fractionally across its sites instead of counting it in full at each one.
        ext.args = { "-g ID -t CDS -F gtf -M${params.featurecounts_fraction ? ' --fraction' : ''}" }
        publishDir = [
            path: { "${params.outdir}/featurecounts" },
            mode: params.publish_dir_mode,
            pattern: "*.featureCounts.*"
        ]
    }

    withName: TIDYVERSE_STRIPCDSPREFIX {
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.gz"
        ]
    }

    withName: FORMAT_CLUSTERREPS {
        // Which loci ended up in which cluster: the provenance behind the protein-consolidated counts
        // table. This is the rewritten table with stable representatives, not MMseqs2's raw output,
        // so the cluster ids here match the counts table exactly.
        publishDir = [
            path: { "${params.outdir}/protein_consolidate" },
            mode: params.publish_dir_mode,
            pattern: "*.clusters.tsv"
        ]
    }

    withName: SEQKIT_GREP {
        // One protein per cluster: the non-redundant protein set, and what the annotation tools
        // actually see for this consolidation level.
        ext.prefix = { "${meta.id}.representatives" }
        publishDir = [
            path: { "${params.outdir}/protein_consolidate" },
            mode: params.publish_dir_mode,
            pattern: "*.gz"
        ]
    }

    withName: '.*:MMSEQS_FASTA_CLUSTER:MMSEQS_LINCLUST' {
        ext.args   = { "--min-seq-id ${params.cluster_min_seq_id} -c ${params.cluster_coverage}" }
        // MMSEQS_LINCLUST refuses to run when its input and output database names are equal, so
        // this has to differ from the prefix MMSEQS_CREATEDB used (which defaults to meta.id).
        ext.prefix = { "${meta.id}.clusters" }
    }

    withName: 'COLLECT_LOCUSCONSOLIDATE|COLLECT_PROTEINCONSOLIDATE' {
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.gz"
        ]
    }

    withName: 'HMMER_HMMSEARCH' {
        publishDir = [
            path: { "${params.outdir}/hmmer" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.tbl.gz"
        ]
    }

    withName: 'SEQTK_HMMHITFAAS' {
        publishDir = [
            path: { "${params.outdir}/hmmer" },
            mode: params.publish_dir_mode,
            pattern: "hits/*.faa.gz"
        ]
    }

    withName: 'HMMER_HMMRANK' {
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.tsv.gz"
        ]
    }

    withName: EGGNOG_DOWNLOAD {
        storeDir = { "${params.eggnog_dbpath}" }
    }

    withName: EGGNOGMAPPER {
        publishDir = [
            path: { "${params.outdir}/eggnog" },
            mode: params.publish_dir_mode,
            pattern: "*.emapper.*.gz"
        ]
    }

    withName: EGGNOG_FORMAT {
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.emapper.tsv.gz"
        ]
    }

    withName: KOFAMSCAN_DOWNLOAD {
        storeDir = { "${params.kofam_dir}" }
    }

    withName: KOFAMSCAN_SCAN {
        ext.args   = '--format detail-tsv'
        ext.prefix = { "${meta.id}.kofamscan_output" }
        publishDir = [
            path: { "${params.outdir}/kofamscan/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: KOFAMSCAN_FORMAT {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/summary_tables/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: KOFAMSCAN_UNIQUE {
        publishDir = [
            path: { "${params.outdir}/summary_tables/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: true
        ]
    }

    withName: RUNDBCAN_DATABASE {
        // We only run protein-mode CAZyme annotation, not CGC/gene-cluster analysis, so skip
        // downloading the CGC-related database assets (transporter/TF/STP/sulfatase/peptidase DBs).
        ext.args = '--no-cgc'
        storeDir = { "${params.dbcan_dbpath}" }
    }

    withName: RUNDBCAN_CAZYMEANNOTATION {
        publishDir = [
            enabled: false
        ]
    }

    withName: DBCAN_FORMAT {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/summary_tables/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.dbcan.tsv.gz"
        ]
    }

    withName: EUKULELE_SEARCH {
        publishDir = [
            [
                pattern: "*/{taxonomy_estimation,taxonomy_counts}/*",
                path: { "${params.outdir}/eukulele" },
                mode: params.publish_dir_mode
            ],
            [
                pattern: "*/mets_full/diamond/*",
                path: { "${params.outdir}/eukulele" },
                mode: params.publish_dir_mode,
                enabled: params.save_eukulele_alignments
            ]
        ]
        ext.args = { params.eukulele_method ? "-m ${params.eukulele_method}" : '' }
    }

    withName: DIAMOND_TAXONOMY {
        publishDir = [
            path: { "${params.outdir}/diamond_taxonomy/" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
        ext.args = { "--top ${params.diamond_top} --compress 1" }
    }

    withName: TAXONKIT_LINEAGE {
        publishDir = [
            enabled: false
        ]
        ext.args = { "--taxid-field 2" }
    }

    withName: PIGZ_DIAMOND_LINEAGE {
        publishDir = [
            path: { "${params.outdir}/diamond_taxonomy/" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }

    withName: FORMAT_DIAMOND_TAX_RANKLIST {
        publishDir = [
            path: { "${params.outdir}/summary_tables/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: true
        ]
    }

    withName: FORMAT_DIAMOND_TAX_TAXDUMP {
        publishDir = [
            path: { "${params.outdir}/summary_tables/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: true
        ]
        errorStrategy = 'ignore'
    }

    withName: FORMAT_EUKULELE_TAX {
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv.gz',
            saveAs: {
                filename ->
                    filename.equals('versions.yml') ?
                        null :
                        "${meta.id}.eukulele.taxonomy.tsv.gz"
            }
        ]
    }

    withName: SUM_EUKULELE_TAXONOMY {
        ext.prefix = { "${params.eukulele_db ?: 'userdb'}" }
    }

    withName: COLLECT_STATS {
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.gz"
        ]
    }

    withName: TRANSRATE {
        publishDir = [
            path: { "${params.outdir}/transrate" },
            mode: params.publish_dir_mode,
            pattern: "*"
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: "${params.outdir}/multiqc",
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
