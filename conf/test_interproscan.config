/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/metatdenovo -profile test_interproscan,<docker/singularity>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test interproscan profile'
    config_profile_description = 'Minimal test dataset to check pipeline with InterProScan function added'

    // Input data
    input = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/samplesheet.csv'

    // Tiny InterProScan database (SFLD/HAMAP/TIGRFAM member databases only, no Pfam/PANTHER)
    // instead of the real several-GB release archive -- shared with the vendored INTERPROSCAN
    // module's own tests. --interproscan_applications is narrowed to SFLD to match what's
    // actually present.
    interproscan_db_url       = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/proteomics/interproscan/interproscan_test.tar.gz'
    interproscan_applications = 'SFLD'

    // parameters
    assembler                  = 'megahit'
    orf_caller                 = 'prodigal'
    skip_eukulele              = true
    skip_eggnog                = true
    skip_kofamscan             = true
    skip_dbcan                 = true
    skip_interproscan          = false
    skip_protein_consolidation = true
}
