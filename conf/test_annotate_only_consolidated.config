/*
========================================================================================
    Nextflow config file for running minimal tests
========================================================================================
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/metatdenovo -profile test_annotate_only_consolidated,<docker/singularity>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile for --annotate_only_consolidated'
    config_profile_description = 'Two ORF callers plus protein consolidation, to check --annotate_only_consolidated (default on) skips per-caller annotation'

    // Input data
    input      = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/samplesheet.csv'

    // Params
    assembler  = 'megahit'
    orf_caller = 'prokka,prodigal'

    // Cheapest annotation already wired into CI (see conf/test.config) -- just enough to tell a
    // per-caller hmmrank table apart from the consolidated one.
    hmmfiles = 'https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF00317.hmm,https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF00848.hmm,https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF03477.hmm,https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF13597.hmm'

    skip_eukulele  = true
    skip_kofamscan = true
    skip_eggnog    = true
    skip_dbcan     = true

    // protein consolidation and annotate_only_consolidated are both deliberately left at their
    // defaults (on) -- that combination is exactly what this profile exists to exercise.
}
