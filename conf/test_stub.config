/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running the -stub pipeline test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Multiple ORF callers, protein consolidation on, every annotation tool enabled -- none
    of that needs a real database in -stub mode, and it is precisely the combination the
    other test profiles can't afford to run for real (large annotation databases, one
    profile per tool to keep CI disk usage down).

    Use as follows:
        nextflow run nf-core/metatdenovo -profile test_stub,<docker/singularity> -stub

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Stub test profile'
    config_profile_description = 'Multi-caller, multi-annotation-tool -stub run to catch channel-wiring bugs cheaply'

    // Input data -- same samplesheet/HMMs/filter as the default test profile
    input           = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/samplesheet.csv'
    hmmfiles        = 'https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF00317.hmm,https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF00848.hmm,https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF03477.hmm,https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF13597.hmm'
    sequence_filter = 'https://github.com/nf-core/test-datasets/raw/metatdenovo/test_data/rrna.fna.gz'

    assembler  = 'megahit'
    orf_caller = 'prokka,transdecoder'

    // Protein consolidation on (the default), but with annotate_only_consolidated off: this
    // makes every active ORF caller's own protein set -- not just the consolidated one --
    // reach each annotation tool, exercising "N active callers => N annotation tasks" rather
    // than the single-task-per-tool shape annotate_only_consolidated=true collapses to.
    skip_protein_consolidation = false
    annotate_only_consolidated = false

    skip_eggnog    = false
    skip_kofamscan = false
    skip_dbcan     = false
    skip_eukulele  = false

    eukulele_db         = 'phylodb'
    kofam_ko_list_url   = params.pipelines_testdata_base_path + 'metatdenovo/test_data/kofamscan/ko_list.gz'
    kofam_profiles_url  = params.pipelines_testdata_base_path + 'metatdenovo/test_data/kofamscan/profiles.tar.gz'
}
