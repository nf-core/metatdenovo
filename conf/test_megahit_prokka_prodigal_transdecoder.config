/*
========================================================================================
    Nextflow config file for running minimal tests
========================================================================================
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/metatdenovo -profile test_megahit_prokka_prodigal_transdecoder,<docker/singularity>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile for multiple ORF callers (prokka + prodigal + transdecoder)'
    config_profile_description = 'Minimal test dataset to check pipeline function with multiple --orf_caller values'

    // Input data
    input    = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/samplesheet.csv'

    // Params
    assembler  = 'megahit'
    // prokka and prodigal both route their GFF output through the shared UNPIGZ_GFF process --
    // included together (rather than just prokka+transdecoder) so the fix for UNPIGZ_GFF being
    // called from more than one active `if ('X' in orf_callers)` block in the same run gets real
    // regression coverage; transdecoder never touches that process.
    orf_caller = 'prokka,prodigal,transdecoder'

    // Deliberately turn on hmmfiles + kofamscan (tiny 20-KO test database, unlike eggnog/dbcan
    // which have no small test database and would download several GB) + diamond_dbs, unlike the
    // existing solo prokka/prodigal/transdecoder profiles which skip everything -- so the
    // multi-caller join/grouping fixes downstream of ORF calling get real regression coverage.
    hmmfiles           = 'https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF00317.hmm,https://raw.githubusercontent.com/nf-core/test-datasets/metatdenovo/test_data/PF00848.hmm'
    diamond_dbs        = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/diamond_dbs.csv'
    kofam_ko_list_url  = params.pipelines_testdata_base_path + 'metatdenovo/test_data/kofamscan/ko_list.gz'
    kofam_profiles_url = params.pipelines_testdata_base_path + 'metatdenovo/test_data/kofamscan/profiles.tar.gz'

    // Other options
    skip_eukulele  = true
    skip_kofamscan = false
    skip_eggnog    = true
    skip_dbcan     = true
}
