/*
========================================================================================
    Nextflow config file for running minimal tests
========================================================================================
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/metatdenovo -profile test_megahit_prokka_prodigal_transdecoder,<docker/singularity>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile for multiple ORF callers (prokka + prodigal + transdecoder)'
    config_profile_description = 'Minimal test dataset to check pipeline function with multiple --orf_caller values'

    // Input data
    input    = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/samplesheet.csv'

    // Params
    assembler  = 'megahit'
    // prokka and prodigal both route their GFF output through the shared UNPIGZ_GFF process --
    // included together (rather than just prokka+transdecoder) so the fix for UNPIGZ_GFF being
    // called from more than one active `if ('X' in orf_callers)` block in the same run gets real
    // regression coverage; transdecoder never touches that process.
    orf_caller = 'prokka,prodigal,transdecoder'

    // No hmmfiles/kofamscan here (unlike an earlier version of this profile): three ORF callers'
    // own containers (prokka, prodigal, transdecoder) plus a full annotation-tool set in one CI job
    // exhausted the runner's disk ("no space left on device" mid-PROKKA_SUBSETS, confirmed via
    // `nf-test --shard`: this profile runs alone in its own shard). Dropping these two loses nothing
    // -- KOFAMSCAN_SUM/EGGNOG_SUM/DBCAN_SUM's join-by-caller fix is keyed uniquely per caller
    // regardless of how many callers are active, so a single-caller test (tests/kofamscan.nf.test)
    // already proves the mechanism; N=1 vs N>1 doesn't change that join's risk.
    //
    // diamond_dbs is kept, unlike hmmfiles/kofamscan: the real bug this profile actually caught
    // (Nextflow's .join() silently dropping duplicate left-side keys) needs multiple callers sharing
    // the same db-name key, which a single-caller test -- even with multiple diamond dbs, like
    // tests/diamond.nf.test -- can never produce.
    diamond_dbs = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/diamond_dbs.csv'

    skip_eukulele  = true
    skip_kofamscan = true
    skip_eggnog    = true
    skip_dbcan     = true
}
