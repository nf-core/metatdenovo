/*
========================================================================================
    Nextflow config file for running minimal tests
========================================================================================
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/metatdenovo -profile test_megahit_prokka_prodigal,<docker/singularity>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile for multiple ORF callers (prokka + prodigal)'
    config_profile_description = 'Minimal test dataset to check pipeline function with multiple --orf_caller values that both use UNPIGZ_GFF'

    // Input data
    input      = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/samplesheet.csv'

    // Params
    assembler  = 'megahit'
    // Prokka and Prodigal both route their GFF output through the shared UNPIGZ_GFF process, which
    // used to be invoked from one `if` block per caller -- fatal once more than one of those blocks
    // ran in the same execution (Nextflow doesn't allow the same unaliased process to be invoked
    // twice in one workflow context). No annotation extras here (see
    // conf/test_megahit_prokka_transdecoder.config for diamond_dbs coverage of the separate
    // join()-duplicate-key bug) -- this profile's only job is proving the UNPIGZ_GFF fix, kept
    // deliberately light after an earlier, heavier combined test exhausted the CI runner's disk.
    orf_caller = 'prokka,prodigal'

    skip_eukulele  = true
    skip_kofamscan = true
    skip_eggnog    = true
    skip_dbcan     = true
}
