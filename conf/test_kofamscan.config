/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/metatdenovo -profile test_kofamscan,<docker/singularity>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test kofamscan profile'
    config_profile_description = 'Minimal test dataset to check pipeline with kofamscan function added'

    // Input data
    input = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/samplesheet.csv'

    // Tiny KOfam database (20 KOs) instead of the real ~1.5GB profiles.tar.gz
    kofam_ko_list_url  = params.pipelines_testdata_base_path + 'metatdenovo/test_data/kofamscan/ko_list.gz'
    kofam_profiles_url = params.pipelines_testdata_base_path + 'metatdenovo/test_data/kofamscan/profiles.tar.gz'

    // parameters
    assembler      = 'megahit'
    orf_caller     = 'prodigal'
    skip_eukulele  = true
    skip_eggnog    = true
    skip_kofamscan = false
    skip_dbcan     = true
}
